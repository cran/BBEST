Package: BBEST
Type: Package
Title: Bayesian Estimation of Incoherent Neutron Scattering Backgrounds
Version: 0.1-9
Date: 2026-09-04
Authors@R: c(
    person("Anton", "Gagin", role = c("aut", "cre"),
           email = "av.gagin@gmail.com"),
    person("Igor", "Levin", role = "aut"),
    person(c("Charles", "R."), "Hogg III", role = "ctb")
